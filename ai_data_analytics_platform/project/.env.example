# Copy this file to ".env" and fill in a key ONLY if you want optional
# AI/LLM-enhanced natural-language phrasing in "Ask Your Data" and the
# Data Story section. The application works fully without either key --
# all numbers are always calculated with pandas first.

# Option A: Anthropic (Claude)
ANTHROPIC_API_KEY=

# Option B: OpenAI
OPENAI_API_KEY=

# Never commit your real .env file to version control.
